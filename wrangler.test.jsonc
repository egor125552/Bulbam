{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bulbam-api-test",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DEBUG_ERRORS": "true"
  },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bulbam-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "preview_database_id": "bulbam-test"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "UserRealtime"
      },
      {
        "name": "CALL_ROOM",
        "class_name": "CallRoom"
      },
      {
        "name": "VOICE_UPLOAD",
        "class_name": "VoiceUploadRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "realtime-v1",
      "new_sqlite_classes": ["UserRealtime"]
    },
    {
      "tag": "calls-v1",
      "new_sqlite_classes": ["CallRoom"]
    },
    {
      "tag": "voice-upload-v1",
      "new_sqlite_classes": ["VoiceUploadRoom"]
    }
  ]
}
