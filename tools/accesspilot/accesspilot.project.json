{
  "version": 1,
  "name": "Бульбам",
  "provider": "./bulbam-provider.js",
  "mode": "explore",
  "scenarios": [
    {"name": "signed-out", "profile": "guest", "ready": "#signed-out"},
    {"name": "signed-in", "profile": "user", "ready": "#signed-in", "permissions": ["microphone"]}
  ],
  "screens": [
    {"name": "Вход", "selector": "#signed-out"},
    {"name": "Главный экран", "selector": "#signed-in"},
    {"name": "Настройки", "selector": "#settings-dialog"},
    {"name": "Поиск собеседника", "selector": "#user-search-panel"},
    {"name": "Переписка", "selector": "#message-form"},
    {"name": "Звонок", "selector": "#call-panel"},
    {"name": "Резервные коды", "selector": "#backup-codes-result"}
  ],
  "limits": {
    "maxActions": 450,
    "maxStates": 150,
    "maxDepth": 10
  }
}
