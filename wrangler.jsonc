{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bulbam-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
