{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bulbam-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "UserRealtime"
      },
      {
        "name": "CALL_ROOM",
        "class_name": "CallRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "realtime-v1",
      "new_sqlite_classes": ["UserRealtime"]
    },
    {
      "tag": "calls-v1",
      "new_sqlite_classes": ["CallRoom"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
